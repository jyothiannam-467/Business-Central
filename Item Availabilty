    local procedure ExportToExcelILE()
    var
        TransferLine: Record "Transfer Line";
        ILE: Record "Item Ledger Entry";
        RowNo: Integer;
        Window: Dialog;
        ItemNo: Code[20];
    begin
        RowNo := 2;

        TransferLine.Reset();
        CurrPage.SetSelectionFilter(TransferLine);
        TransferLine.SetCurrentKey("Item No.");
        if TransferLine.FindSet() then
            repeat
                if (ItemNo <> TransferLine."Item No.") then begin
                    Clear(ItemNo);
                    ItemNo := TransferLine."Item No.";

                    Window.Open(Msg_01_Lbl);

                    ILE.Reset();
                    ILE.SetRange("Item No.", TransferLine."Item No.");
                    ILE.SetRange("Location Code", TransferLine."Transfer-from Code");
                    ILE.SetFilter("Remaining Quantity", '<>%1', 0);
                    if ILE.FindSet() then
                        repeat
                            EnterCell(RowNo, 1, ILE."Posting Date", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 2, ILE."Entry Type", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 3, ILE."Document Type", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 4, ILE."Document No.", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 5, ILE."Item No.", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 6, ILE.Description, false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 7, ILE."Location Code", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 8, ILE.Quantity, false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 9, ILE."Reserved Quantity", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 10, ILE."Remaining Quantity", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 11, ILE."Invoiced Quantity", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 12, ILE."Serial No.", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 13, ILE."Lot No.", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 14, ILE."Sales Amount (Actual)", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 15, ILE."Cost Amount (Actual)", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 16, ILE."Cost Amount (Non-Invtbl.)", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 17, ILE.Open, false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 18, ILE."Order Type", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            EnterCell(RowNo, 19, ILE."Entry No.", false, false, false, '', TempExcelBuffer."Cell Type"::Text);
                            RowNo := RowNo + 1;
                        Until ILE.Next() = 0;
                end;
            until TransferLine.Next() = 0;
        Window.Close();
    end;
