 action(ExportToExcel)
            {
                Caption = 'ILE Availabilty';
                Image = Excel;
                ApplicationArea = All;
                trigger OnAction()
                begin
                    if Confirm(Confirm_01_Lbl) then begin
                        TempExcelBuffer.Reset();
                        TempExcelBuffer.DeleteAll();
                        CreateExcelHeaderILE();
                        ExportToExcelILE();
                        TempExcelBuffer.CreateNewBook(ReportFileName);
                        TempExcelBuffer.WriteSheet(ReportFileName, CompanyName, UserId);
                        TempExcelBuffer.CloseBook();
                        TempExcelBuffer.SetFriendlyFilename(ReportFileName);
                        TempExcelBuffer.OpenExcel();
                    end;
                End;
            }


local procedure EnterCell(RowNo: Integer; ColumnNo: Integer; CellValue: Variant; Bold: Boolean; Italic: Boolean; UnderLine: Boolean; NumberFormat: Text[30];
       cellTypeP: Option Number,Text,Date,Time)
    begin
        TempExcelBuffer.Init;
        TempExcelBuffer.Validate("Row No.", RowNo);
        TempExcelBuffer.Validate("Column No.", ColumnNo);
        TempExcelBuffer."Cell Value as Text" := Format(CellValue);
        TempExcelBuffer.Formula := '';
        TempExcelBuffer.Bold := Bold;
        TempExcelBuffer.Italic := Italic;
        TempExcelBuffer.Underline := UnderLine;
        TempExcelBuffer.NumberFormat := NumberFormat;
        TempExcelBuffer."Cell Type" := cellTypeP;
        TempExcelBuffer.Insert;
    end;


    local procedure CreateExcelHeaderILE()
    begin
        EnterCell(1, 1, 'Posting Date', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 2, 'Entry Type', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 3, 'Document Type', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 4, 'Document No.', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 5, 'Item No.', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 6, 'Description', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 7, 'Location Code', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 8, 'Quantity', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 9, 'Reserved Quantity', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 10, 'Remaining Quantity', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 11, 'Invoiced Quantity', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 12, 'Serial No.', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 13, 'Lot No.', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 14, 'Sales Amount (Actual)', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 15, 'Cost Amount (Actual)', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
        EnterCell(1, 16, 'Cost Amount (Non-Invtbl.)', true, false, false, '', TempExcelBuffer."Cell Type"::Text);
