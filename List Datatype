A list is a strongly typed one dimension unbounded array

local procedure TestListAssignment()
var
    i: Integer;
    ListNumberOne: List of [Integer];
    ListNumberTwo: List of [Integer];
begin
    for i := 1 to 20 do
        ListNumberOne.Add(i);

    ListNumberTwo := ListNumberOne;

    ListNumberTwo.Add(21);

    Message('List1 count: %1\List2 count: %2', ListNumberOne.Count(), ListNumberTwo.Count());
end;
Note : For ablove Code That's right, the assignment is not copying. We just pass the same memory location to another variable. So be careful. To shallow copy, we should use the GetRange method.
local procedure TestListShallowCopy()
var
    i: Integer;
    ListNumberOne: List of [Integer];
    ListNumberTwo: List of [Integer];
begin
    for i := 1 to 20 do
        ListNumberOne.Add(i);

    ListNumberTwo := ListNumberOne.GetRange(1, ListNumberOne.Count());

    ListNumberTwo.Add(21);

    Message('List1 count: %1\List2 count: %2', ListNumberOne.Count(), ListNumberTwo.Count());
end;

