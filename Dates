  procedure GetMonthText(Month: Integer): Text[5]
    var
        MonthText: Text[5];
    begin
        case Month of
            1:
                MonthText := 'Jan';
            2:
                MonthText := 'Feb';
            3:
                MonthText := 'Mar';
            4:
                MonthText := 'Apr';
            5:
                MonthText := 'May';
            6:
                MonthText := 'June';
            7:
                MonthText := 'July';
            8:
                MonthText := 'Aug';
            9:
                MonthText := 'Sep';
            10:
                MonthText := 'Oct';
            11:
                MonthText := 'Nov';
            12:
                MonthText := 'Dec';
        end;

        Exit(MonthText)
    end;

 procedure GetLastFridayOfYear(Year: Integer): Date
    var
        LastDayOfYear: Date;
        DayOfWeek: Integer;
    begin
        LastDayOfYear := DMY2Date(31, 12, Year);
        DayOfWeek := Date2DWY(LastDayOfYear, 1);
        if DayOfWeek >= 6 then
            LastDayOfYear := LastDayOfYear - (DayOfWeek - 5)
        else
            LastDayOfYear := LastDayOfYear - (7 + DayOfWeek - 5);

        Message('%1', LastDayOfYear);
    end;
