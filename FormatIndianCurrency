procedure FormatNumberIndianStyle(Number: Decimal): Text
var
    FormattedText: Text;
    NumberStr: Text;
    DecimalPart: Text;
    WholeNumberPart: Text;
    Len: Integer;
    i: Integer;
begin
    NumberStr := Format(Number, 0, 9); 

    if StrPos(NumberStr, '.') > 0 then begin
        WholeNumberPart := CopyStr(NumberStr, 1, StrPos(NumberStr, '.') - 1);
        DecimalPart := CopyStr(NumberStr, StrPos(NumberStr, '.'), StrLen(NumberStr) - StrPos(NumberStr, '.') + 1);
    end else begin
        WholeNumberPart := NumberStr;
        DecimalPart := '';
    end;

    Len := StrLen(WholeNumberPart);

    if Len > 3 then
        FormattedText := CopyStr(WholeNumberPart, Len - 2, 3)
    else
        exit(NumberStr); 

    i := Len - 3;
    while i > 0 do begin
        if (i = 1) then
            FormattedText := CopyStr(WholeNumberPart, i, 1) + ',' + FormattedText
        else
            FormattedText := CopyStr(WholeNumberPart, i - 1, 2) + ',' + FormattedText;

        i -= 2;
    end;

    exit(FormattedText + DecimalPart);
end;
