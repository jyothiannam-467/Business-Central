    end;

    procedure CreateDispatch()
    var
        SalesHeader: Record "Sales Header";
        SalesLine: Record "Sales Line";
        DispatchWorksheet: Record "Dispatch Worksheet";
        Item: Record Item;
        ItemlederEntrylrec: Record "Item Ledger Entry";
        LinesInserted: Boolean;
        Window: Dialog;
    begin
        SalesHeader.Reset();
        SalesHeader.SetCurrentKey("Document Date");
        SalesHeader.SetRange("Document Type", SalesHeader."Document Type"::Order);
        SalesHeader.SetRange("Sell-to Customer No.", CustomerNo);
        SalesHeader.SetRange(Status, SalesHeader.Status::Released);
        SalesHeader.SetAscending("Document Date", true);
        if SalesHeader.FindSet() then begin
            repeat
                Window.Open(Msg_02_Lbl);

                SalesLine.Reset();
                SalesLine.SetRange("Document Type", SalesLine."Document Type"::Order);
                SalesLine.SetRange("Document No.", SalesHeader."No.");
                if SalesLine.FindSet() then
                    repeat
                        if SalesLine.Quantity <> SalesLine."Quantity Shipped" then begin
                            if Item.Get(SalesLine."No.") then begin
                                Item.CalcFields(Inventory);
                                if Item.Inventory <> 0 then begin
                                    DispatchWorksheet.Reset();
                                    DispatchWorksheet.SetRange("Sales Order", SalesLine."Document No.");
                                    DispatchWorksheet.SetRange("Line No.", SalesLine."Line No.");
                                    DispatchWorksheet.SetRange("Sell To Customer", CustomerNo);
                                    if not DispatchWorksheet.FindFirst() then begin
                                        DispatchWorksheet.Init();
                                        DispatchWorksheet."Sales Order" := SalesLine."Document No.";
                                        DispatchWorksheet."Sell To Customer" := SalesLine."Sell-to Customer No.";
                                        DispatchWorksheet."Customer Names" := SalesHeader."Sell-to Customer Name";
                                        DispatchWorksheet.Validate("Item no", SalesLine."No.");
                                        DispatchWorksheet."Line No." := SalesLine."Line No.";
                                        DispatchWorksheet."Location Code" := SalesLine."Location Code";
                                        DispatchWorksheet.Validate(Quantity, SalesLine.Quantity);
                                        DispatchWorksheet."Ship To Code" := SalesHeader."Ship-to Code";
                                        DispatchWorksheet."Customer PO No." := SalesHeader."Customer PO No.";
                                        DispatchWorksheet."Customer PO Date" := SalesHeader."Document Date";
                                        DispatchWorksheet."OutSatnding Qty" := SalesLine."Outstanding Quantity";
                                        DispatchWorksheet."Delivery Date" := SalesLine."Planned Delivery Date";
                                        DispatchWorksheet.Validate("Dispatched Qty");
                                        DispatchWorksheet.Validate("Dispatch Qty");
                                        DispatchWorksheet.Insert(true);
                                        LinesInserted := true;
                                    end;
                                end;
                            end;
                        End;
                    until SalesLine.Next() = 0;
            until SalesHeader.Next() = 0
        end;

        Window.Close();

        if LinesInserted then
            Message(Msg_01_Lbl);
    end;


    local procedure PostDispatch()
    var
        DispatchWorksheet: Record "Dispatch Worksheet";
        Item: Record Item;
        SalesHeader: Record "Sales Header";
        SalesLine: Record "Sales Line";
        SalesPost: Codeunit "Sales-Post";
        Window: Dialog;
    begin
        DispatchWorksheet.Reset();
        CurrPage.SetSelectionFilter(DispatchWorksheet);
        if DispatchWorksheet.FindSet() then
            repeat
                if DispatchWorksheet."Dispatch Qty" = 0 then
                    Error(Err_02_Lbl, DispatchWorksheet."Sales Order", DispatchWorksheet."Line No.");

                Window.Open(Msg_04_Lbl);

                SalesHeader.Reset();
                SalesHeader.SetRange("Document Type", SalesHeader."Document Type"::Order);
                SalesHeader.SetRange("No.", DispatchWorksheet."Sales Order");
                if SalesHeader.FindFirst() then begin
                    SalesHeader.Ship := true;
                    SalesHeader.Modify();

                    SalesLine.Reset();
                    SalesLine.SetRange("Document Type", SalesLine."Document Type"::Order);
                    SalesLine.SetRange("Document No.", SalesHeader."No.");
                    if SalesLine.FindSet() then
                        repeat
                            if SalesLine."Line No." = DispatchWorksheet."Line No." then
                                SalesLine.Validate("Qty. to Ship", DispatchWorksheet."Dispatch Qty")
                            else
                                SalesLine.Validate("Qty. to Ship", 0);
                            SalesLine.Modify();
                        until SalesLine.Next() = 0;

                    InitReservEntryAgainstQtyToDispatch(SalesHeader, DispatchWorksheet);

                    SalesPost.Run(SalesHeader);
                end;

                DispatchWorksheet.Validate("Dispatched Qty");
                DispatchWorksheet."Dispatch Qty" := 0;
                DispatchWorksheet.Modify();

                if DispatchWorksheet.Quantity = DispatchWorksheet."Dispatched Qty" then
                    DispatchWorksheet.Delete();

            until DispatchWorksheet.Next() = 0;

        Window.Close();
    end;

    local procedure InitReservEntryAgainstQtyToDispatch(SalesHeader: Record "Sales Header"; DispatchWorksheet: Record "Dispatch Worksheet")
    var
        SalesLine: Record "Sales Line";
        ItemLedgEntry: Record "Item Ledger Entry";
        ReservationEntry: Record "Reservation Entry";
        TotalRequiredQty, TotalReservedQty, QtyToReserve : Decimal;
        EntryNo, Sign : Integer;
    begin
        //Deleting Previous Reservation Entries
        ReservationEntry.Reset();
        ReservationEntry.SetRange("Source Type", 37);
        ReservationEntry.Setrange("Source Subtype", 1);
        ReservationEntry.SetRange("Source ID", DispatchWorksheet."Sales Order");
        ReservationEntry.SetRange("Source Ref. No.", DispatchWorksheet."Line No.");
        ReservationEntry.SetRange("Item No.", DispatchWorksheet."Item no");
        if ReservationEntry.FindSet() then
            ReservationEntry.DeleteAll();

        TotalRequiredQty := 0;
        TotalReservedQty := 0;
        Sign := -1;

        SalesLine.Reset();
        SalesLine.SetRange("Document Type", SalesLine."Document Type"::Order);
        SalesLine.SetRange("Document No.", DispatchWorksheet."Sales Order");
        SalesLine.SetRange("No.", DispatchWorksheet."Item No");
        if SalesLine.FindSet() then
            repeat
                TotalRequiredQty += SalesLine."Qty. to Ship";
            until SalesLine.Next() = 0;

        ItemLedgEntry.Reset();
        ItemLedgEntry.SetCurrentKey("Entry No.");
        ItemLedgEntry.CalcFields("Reserved Quantity");
        ItemLedgEntry.SetRange("Item No.", DispatchWorksheet."Item No");
        ItemLedgEntry.SetRange("Location Code", DispatchWorksheet."Location Code");
        ItemLedgEntry.SetFilter("Remaining Quantity", '<>0');
        ItemLedgEntry.SetAscending("Entry No.", false); // FIFO sorting
        if ItemLedgEntry.FindSet() then
            repeat
                QtyToReserve := 0;
                EntryNo := 0;

                TotalReservedQty := ItemLedgEntry."Reserved Quantity";

                if TotalRequiredQty - TotalReservedQty > 0 then begin
                    if (TotalRequiredQty - TotalReservedQty) > ItemLedgEntry."Remaining Quantity" then
                        QtyToReserve := ItemLedgEntry."Remaining Quantity"
                    else
                        QtyToReserve := (TotalRequiredQty - TotalReservedQty);

                    ReservationEntry.Reset();
                    if ReservationEntry.FindLast() then
                        EntryNo := ReservationEntry."Entry No." + 1
                    else
                        EntryNo := 1;

                    //Creating New Reservation Entries
                    ReservationEntry.Reset();
                    ReservationEntry.SetRange("Source Type", 37);
                    ReservationEntry.Setrange("Source Subtype", 1);
                    ReservationEntry.SetRange("Source ID", DispatchWorksheet."Sales Order");
                    ReservationEntry.SetRange("Source Ref. No.", DispatchWorksheet."Line No.");
                    ReservationEntry.SetRange("Item No.", DispatchWorksheet."Item no");
                    ReservationEntry.SetRange(Quantity, QtyToReserve);
                    if Not ReservationEntry.FindFirst() then begin
                        ReservationEntry.Init();

                        ReservationEntry."Entry No." := EntryNo;
                        ReservationEntry."Reservation Status" := ReservationEntry."Reservation Status"::Prospect;

                        ReservationEntry."Source Type" := Database::"Sales Line";
                        ReservationEntry."Source Subtype" := 1;
                        ReservationEntry."Source ID" := DispatchWorksheet."Sales Order";
                        ReservationEntry."Source Ref. No." := DispatchWorksheet."Line No.";

                        ReservationEntry."Item No." := DispatchWorksheet."Item No";
                        ReservationEntry."Location Code" := SalesHeader."Location Code";
                        ReservationEntry."Shipment Date" := SalesHeader."Shipment Date";

                        if SalesLine.get(SalesLine."Document Type"::Order, DispatchWorksheet."Sales Order", DispatchWorksheet."Line No.") then
                            ReservationEntry."Qty. per Unit of Measure" := SalesLine."Qty. per Unit of Measure";

                        ReservationEntry.Quantity := Sign * QtyToReserve;
                        ReservationEntry.Validate("Quantity (Base)", Sign * QtyToReserve);
                        ReservationEntry."Lot No." := ItemLedgEntry."Lot No.";
                        ReservationEntry."Serial No." := ItemLedgEntry."Serial No.";

                        ReservationEntry."Creation Date" := WorkDate();
                        ReservationEntry."Created By" := CopyStr(UserId(), 1, 50);

                        ReservationEntry."Item Ledger Entry No." := ItemLedgEntry."Entry No.";
                        if (ItemLedgEntry."Lot No." <> '') and (ItemLedgEntry."Serial No." <> '') then
                            ReservationEntry."Item Tracking" := ReservationEntry."Item Tracking"::"Lot and Serial No."
                        else
                            if ItemLedgEntry."Lot No." <> '' then
                                ReservationEntry."Item Tracking" := ReservationEntry."Item Tracking"::"Lot No."
                            else
                                if ItemLedgEntry."Serial No." <> '' then
                                    ReservationEntry."Item Tracking" := ReservationEntry."Item Tracking"::"Serial No.";
                        ReservationEntry.Positive := (ReservationEntry."Quantity (Base)" > 0);

                        ReservationEntry.Insert();

                        TotalReservedQty += QtyToReserve;
                    end;
                end;
            until (ItemLedgEntry.Next() = 0) or (TotalReservedQty >= TotalRequiredQty);
    end;


