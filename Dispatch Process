table 50034 "Dispatch Worksheet"
{
    Caption = 'Dispatch Worksheet';
    DataClassification = CustomerContent;

    fields
    {
        field(1; "Entry No."; Integer)
        {
            AutoIncrement = true;
            Caption = 'Line No.';
            DataClassification = CustomerContent;
        }
        field(2; "Sales Order"; Code[20])
        {
            Caption = 'Sale Order No.';
            TableRelation = "Sales Header"."No." where("Document Type" = filter('Order'));
            DataClassification = CustomerContent;
        }
        field(3; "Production Order no"; code[20])
        {
            Caption = 'Production Number';
            DataClassification = CustomerContent;
        }
        field(4; "Sell To Customer"; Text[100])
        {
            Caption = 'Customer No.';
            TableRelation = Customer."No.";
            DataClassification = CustomerContent;
        }
        field(5; "Ship To Code"; Code[10])
        {
            DataClassification = CustomerContent;
            Caption = 'Ship To Code';
            TableRelation = "Sales Header"."Ship-to Code";
            ValidateTableRelation = false;
        }
        field(6; "Item no"; Code[20])
        {
            DataClassification = CustomerContent;
            Caption = 'Item No.';
            TableRelation = Item."No.";
            trigger OnValidate()
            var
                Item: Record Item;
            begin
                if Item.Get(Rec."Item no") then begin
                    Rec."Per Weight" := Item."Net Weight";
                    Rec."Qty per CT" := Item."Qty per CT";
                    Rec."Total Weight" := Item."Net Weight" * Item."Qty per CT";
                    Rec.Description := Item.Description;
                end
                Else begin
                    Rec."Per Weight" := 0;
                    Rec."Qty per CT" := 0;
                    Rec."Total Weight" := 0;
                    Rec.Description := '';
                end;
            End;
        }
        field(7; Description; Text[100])
        {
            Caption = 'Item Description';
            DataClassification = CustomerContent;
        }
        field(8; Quantity; Decimal)
        {
            DataClassification = CustomerContent;
            Caption = 'Quantity';
            trigger OnValidate()
            begin
                if Quantity <> 0 then
                    Rec."Pending Dispatch" := Rec.Quantity - Rec."Dispatched Qty";
            end;
        }
        field(9; "Dispatch Quantity"; Decimal)
        {
            DataClassification = CustomerContent;
            Caption = 'Dispatch Quantity';
        }
        field(10; "OutSatnding Qty"; Decimal)
        {
            DataClassification = CustomerContent;
            Caption = 'OutSatnding Qty';
        }
        field(11; "Delivery Date"; Date)
        {
            DataClassification = CustomerContent;
            Caption = 'Delivery Date';
        }
        field(12; "Routing Status"; Option)
        {
            OptionMembers = " ",Planned,"In Progress",Finished;
            OptionCaption = ' ,Planned,In Progress,Finished';
            DataClassification = CustomerContent;
        }
        field(13; "Total Weight"; Decimal)
        {
            DataClassification = ToBeClassified;
        }
        field(14; "Ready Qty"; Decimal)
        {
            DataClassification = ToBeClassified;
        }
        field(15; "Dispatched Qty"; Decimal)
        {
            AccessByPermission = TableData "Sales Shipment Header" = R;
            Caption = 'Dispatched Qty';
            DecimalPlaces = 0 : 5;
            Editable = false;
            DataClassification = ToBeClassified;
            trigger OnValidate()
            var
                SalesShipmentLine: Record "Sales Shipment Line";
                DispatchedQty: Decimal;
            begin
                Clear(DispatchedQty);

                SalesShipmentLine.SetCurrentKey("Document No.", "No.", "Shipment Date");
                SalesShipmentLine.SetRange("Order No.", Rec."Sales Order");
                SalesShipmentLine.SetRange("Order Line No.", Rec."Line No.");
                SalesShipmentLine.SetFilter(Quantity, '<>%1', 0);
                SalesShipmentLine.CalcSums(Quantity);
                DispatchedQty := SalesShipmentLine.Quantity;

                Rec."Dispatched Qty" := DispatchedQty;
                Rec."Pending Dispatch" := Rec.Quantity - Rec."Dispatched Qty";
            end;
        }
        field(16; "Qty per CT"; Decimal)
        {
            DataClassification = ToBeClassified;
        }
        field(17; "Customer Names"; text[250])
        {
            Caption = 'Customer Name';
            DataClassification = ToBeClassified;
        }
        field(18; "Per Weight"; Decimal)
        {
            DataClassification = ToBeClassified;
        }
        field(19; "Pending Dispatch"; Decimal)
        {
            DataClassification = ToBeClassified;
        }
        field(20; "Dispatch Qty"; Decimal)
        {
            Caption = 'Dispatch Qty';
            DataClassification = ToBeClassified;
            trigger OnValidate()
            begin
                Rec."Pending Dispatch" := Rec.Quantity - Rec."Dispatched Qty";
                if Rec."Dispatch Qty" > "Pending Dispatch" then
                    Error(Err_01_Lbl);
            end;
        }
        field(21; "Location Code"; Code[20])
        {
            DataClassification = ToBeClassified;
        }
        field(22; Availability; Decimal)
        {
            FieldClass = FlowField;
            CalcFormula = Sum("Item Ledger Entry".Quantity WHERE("Item No." = FIELD("Item no"), "Location Code" = FIELD("Location code"), "Remaining Quantity" = FILTER(<> 0)));
        }
        field(23; "Line No."; Integer)
        {
            DataClassification = ToBeClassified;
        }
        field(24; "Customer PO No."; Code[20])
        {
            DataClassification = ToBeClassified;
        }
        field(25; "Customer PO Date"; Date)
        {
            DataClassification = ToBeClassified;
        }
    }
    keys
    {
        key(PK; "Entry No.")
        {
            Clustered = true;
        }
    }
    trigger OnInsert()
    var
        DispacthWorksheet: Record "Dispatch Worksheet";
    begin
        DispacthWorksheet.Reset();
        if DispacthWorksheet.FindLast() then
            Rec."Entry No." := DispacthWorksheet."Entry No." + 1
        else
            Rec."Entry No." := 1;
    end;

    var
        Err_01_Lbl: Label 'Qty to dispatch must be less than the pending dispatch';
}
