    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Purch.-Post", 'OnAfterPostPurchaseDoc', '', false, false)]

    local procedure OnAfterPostPurchaseDoc(var GenJnlPostLine: Codeunit "Gen. Jnl.-Post Line"; PurchInvHdrNo: Code[20]; CommitIsSupressed: Boolean)
    var
        GenJnlLine: Record "Gen. Journal Line";
        FixedAsset: Record "Fixed Asset";
        FADeprBook: Record "FA Depreciation Book";
        PurchInvLine: Record "Purch. Inv. Line";
        QtyVar, i, LineNo : Integer;
        LastGenJnlLine: Record "Gen. Journal Line";
        PurchPaySetup: Record "Purchases & Payables Setup";
    begin
        PurchPaySetup.Get();
        if (PurchPaySetup."FA Jnl. Tem. Name" = '') or (PurchPaySetup."FA Jnl. Batch Name" = '') then
            exit;

        LastGenJnlLine.Reset;
        LastGenJnlLine.SetRange("Journal Template Name", PurchPaySetup."FA Jnl. Tem. Name");
        LastGenJnlLine.SetRange("Journal Batch Name", PurchPaySetup."FA Jnl. Batch Name");
        if LastGenJnlLine.FindLast() then
            LineNo := LastGenJnlLine."Line No." + 10000
        else
            LineNo := 10000;

        PurchInvLine.Reset();
        PurchInvLine.SetRange("Document No.", PurchInvHdrNo);
        PurchInvLine.SetFilter("No.", '<>%1', '');
        PurchInvLine.SetRange(Type, PurchInvLine.Type::"G/L Account");
        PurchInvLine.SetFilter("Receipt No.", '<>%1', '');
        if PurchInvLine.FindSet() then
            repeat
                QtyVar := 0;
                FixedAsset.Reset();
                FixedAsset.SetRange("Receipt No.", PurchInvLine."Receipt No.");
                FixedAsset.SetRange("Receipt Line No.", PurchInvLine."Receipt Line No.");
                FixedAsset.SetRange(Acquired, false);
                if FixedAsset.FindSet() then begin
                    repeat
                        FADeprBook.Reset();
                        FADeprBook.SetRange("FA No.", FixedAsset."No.");
                        if FADeprBook.FindFirst() then;

                        QtyVar += 1;
                        GenJnlLine.Init();
                        GenJnlLine.Validate("Journal Template Name", PurchPaySetup."FA Jnl. Tem. Name");
                        GenJnlLine.Validate("Journal Batch Name", PurchPaySetup."FA Jnl. Batch Name");
                        GenJnlLine.Validate("Line No.", LineNo);
                        LineNo += 10000;
                        GenJnlLine.Validate("Account Type", GenJnlLine."Account Type"::"Fixed Asset");
                        GenJnlLine.Validate("Document Type", GenJnlLine."Document Type"::Invoice);
                        GenJnlLine.Validate("Account No.", FixedAsset."No.");
                        GenJnlLine.Validate("Document No.", PurchInvLine."Document No.");
                        GenJnlLine.Validate("Bal. Account Type", GenJnlLine."Bal. Account Type"::"G/L Account");
                        GenJnlLine.Validate("Bal. Account No.", PurchInvLine."No.");
                        GenJnlLine.Validate(Description, PurchInvLine.Description);
                        GenJnlLine.Validate("Posting Date", PurchInvLine."Posting Date");
                        GenJnlLine.Validate("FA Posting Date", PurchInvLine."Posting Date");
                        GenJnlLine.Validate("FA Posting Type", GenJnlLine."FA Posting Type"::"Acquisition Cost");
                        GenJnlLine.Validate("Depreciation Book Code", FADeprBook."Depreciation Book Code");
                        GenJnlLine.Validate(Amount, (PurchInvLine.Amount / PurchInvLine.Quantity));
                        GenJnlLine.Validate("Shortcut Dimension 1 Code", PurchInvLine."Shortcut Dimension 1 Code");
                        GenJnlLine.Validate("Shortcut Dimension 2 Code", PurchInvLine."Shortcut Dimension 2 Code");
                        GenJnlLine.Validate("Dimension Set ID", PurchInvLine."Dimension Set ID");
                        GenJnlLine.Validate("Bal. Gen. Bus. Posting Group", '');
                        GenJnlLine.Validate("Bal. Gen. Prod. Posting Group", '');
                        GenJnlLine.Validate("Gen. Bus. Posting Group", '');
                        GenJnlLine.Validate("Gen. Prod. Posting Group", '');
                        GenJnlPostLine.RunWithCheck(GenJnlLine);
                    until (FixedAsset.Next = 0) or (QtyVar = Round(PurchInvLine.Quantity));
                end;
            until PurchInvLine.Next() = 0;
    end;
