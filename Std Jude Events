    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Gen. Jnl.-Post Preview", 'OnBeforeRunPreview', '', false, false)]
    local procedure OnBeforeRunPreview(Subscriber: Variant; RecVar: Variant)
    var
        GenJnlBatch: Record "Gen. Journal Batch";
        NoSeriesLine: Record "No. Series Line";
        NoSeries: Record "No. Series";
        NoSeriesMgt: Codeunit NoSeriesManagement;
        PreviewErrorLbl: Label 'Document Number should be greater than %1 for Line No %2.';
        Text001: Label 'This Document No. %1 has been Posted.';
        Text002: Label 'This Document No. %1 has been Greater than %2.';
        Text003: Label 'This Document No. %1 has been not match with Present No.Series %2';
        PosGenJnlLine: Record "Posted Gen. Journal Line";
        GetNextNoRec: Code[20];
        GenJournalLine_Loc1: Record "Gen. Journal Line";
        GenJournalLine_Loc2: Record "Gen. Journal Line";
        XDocumentNo: Code[20];
        RecRef: RecordRef;
    begin
        if RecVar.IsRecord then begin
            RecRef.GetTable(RecVar);
            if RecRef.Number = Database::"Gen. Journal Line" then begin
                GenJournalLine_Loc1.Get(RecRef.RecordId);
                //GenJournalLine_Loc1 := RecVar;
                GenJnlBatch.Get(GenJournalLine_Loc1."Journal Template Name", GenJournalLine_Loc1."Journal Batch Name");
                NoSeries.Get(GenJnlBatch."No. Series");
                if not NoSeries."Manual Nos." then begin
                    GenJournalLine_Loc2.Reset();
                    GenJournalLine_Loc2.SetRange("Journal Template Name", GenJournalLine_Loc1."Journal Template Name");
                    GenJournalLine_Loc2.SetRange("Journal Batch Name", GenJournalLine_Loc1."Journal Batch Name");
                    if GenJournalLine_Loc2.FindSet() then
                        repeat
                            PosGenJnlLine.Reset();
                            PosGenJnlLine.SetRange("Journal Template Name", GenJournalLine_Loc2."Journal Template Name");
                            PosGenJnlLine.SetRange("Journal Batch Name", GenJournalLine_Loc2."Journal Batch Name");
                            PosGenJnlLine.SetRange("Document No.", GenJournalLine_Loc2."Document No.");
                            if PosGenJnlLine.FindFirst() then begin
                                if PosGenJnlLine."Document No." = GenJournalLine_Loc2."Document No." then
                                    Error(Text001, GenJournalLine_Loc2."Document No.")
                                else begin
                                    GetNextNoRec := NoSeriesMgt.GetNextNo(GenJnlBatch."No. Series", 0D, false);
                                    if GetNextNoRec <> GenJournalLine_Loc2."Document No." then
                                        Error(Text002, GenJournalLine_Loc2."Document No.", GetNextNoRec);
                                end;
                            end else begin
                                if (XDocumentNo <> GenJournalLine_Loc2."Document No.") then begin
                                    XDocumentNo := GenJournalLine_Loc2."Document No.";
                                    GetNextNoRec := NoSeriesMgt.GetNextNo(GenJnlBatch."No. Series", 0D, false);
                                    if (GetNextNoRec <> GenJournalLine_Loc2."Document No.") then
                                        Error(Text003, GenJournalLine_Loc2."Document No.", GetNextNoRec);
                                end;
                            End;
                        until GenJournalLine_Loc2.Next() = 0;
                end;
            end;
        end;
    End;

