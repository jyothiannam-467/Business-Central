    var
        GenJournalLine2: Record "Gen. Journal Line";
    //GenJnlpostLine: codeunit "Gen. Jnl.-Post Line";
    begin
        //GenJournalLine.CopyFilters(GenJnlLine);
        if GenJournalLine.FindSet() then
            repeat
                if GenJournalLine."Document Type" = GenJournalLine."Document Type"::Payment then
                    if (GenJournalLine."Revenue G/L Account" <> '') and ((GenJournalLine."Account Type" = GenJournalLine."Account Type"::Customer) or (GenJournalLine."Bal. Account Type" = GenJournalLine."Bal. Account Type"::Customer)) then begin
                        GenJournalLine2.Copy(GenJournalLine);
