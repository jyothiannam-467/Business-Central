codeunit 50005 "Base Events Single Instance"
{
    SingleInstance = true;
    Permissions =
        tabledata "Document Attachment" = R,
        tabledata "Purch. Inv. Header" = RM,
        tabledata Vendor = R,
        tabledata "G/L Entry" = RM,
        tabledata "Purch. Cr. Memo Hdr." = RM,
        tabledata "Bank Account Ledger Entry" = RM;

    var
        PANNo: Code[20];

    [EventSubscriber(ObjectType::Page, Page::"Vendor Card", 'OnBeforeCreateVendorFromTemplate', '', false, false)]
    local procedure OnBeforeCreateVendorFromTemplate(var Vendor: Record Vendor; var NewMode: Boolean)
    var
        VendorPANCheck: page "Vendor PAN Check";
        ErrTxt1: Label 'P.A.N. No. must have a value.';
        ErrTxt2: Label 'Entered P.A.N. No. - %1 is already exists against to Vendor No. - %2';
        VendorLRec: Record Vendor;
    begin
        Clear(PANNo);
        VendorPANCheck.RunModal();
        VendorPANCheck.GetPANNo(PANNo);
        if PANNo = '' then
            Error(ErrTxt1);
        VendorLRec.Reset();
        VendorLRec.SetRange("P.A.N. No.", PANNo);
        if VendorLRec.FindFirst() then
            Error(ErrTxt2, PANNo, VendorLRec."No.");
        Commit();
    end;

    [EventSubscriber(ObjectType::Page, Page::"Vendor Card", 'OnCreateVendorFromTemplateOnBeforeCurrPageUpdate', '', false, false)]
    local procedure OnCreateVendorFromTemplateOnBeforeCurrPageUpdate(var Vendor: Record Vendor)
    begin
        Vendor."P.A.N. No." := PANNo;
    end;

    [EventSubscriber(ObjectType::Table, Database::Vendor, 'OnBeforeOnInsert', '', false, false)]
    local procedure OnBeforeOnInsert(var Vendor: Record Vendor)
    begin
        if PANNo <> '' then
            Vendor."P.A.N. No." := PANNo;
    end;

    procedure AttachmentIncluded()
    var
        PurchInvHeader: Record "Purch. Inv. Header";
        DocumentAttachment: Record "Document Attachment";
    begin
        begin
            PurchInvHeader.Reset();
            if PurchInvHeader.FindSet() then begin
                repeat
                    DocumentAttachment.SetRange("Table ID", Database::"Purch. Inv. Header");
                    DocumentAttachment.SetRange("No.", PurchInvHeader."No.");
                    if DocumentAttachment.FindFirst() then begin
                        PurchInvHeader."Attachment Included" := true;
                    end
                    else begin
                        PurchInvHeader."Attachment Included" := false;
                    end;
                until PurchInvHeader.Next() = 0;
            end;
        end;
    end;

    procedure AttachmentIncludedInGLEntries()
    var
        GlEntryGrec: Record "G/L Entry";
        DocumentAttachment: Record "Document Attachment";
        PostedGenJournalLine: Record "Posted Gen. Journal Line";
    begin
        GlEntryGrec.Reset();
        if GlEntryGrec.FindSet() then
            repeat
                PostedGenJournalLine.Reset();
                PostedGenJournalLine.SetRange("Document No.", GlEntryGrec."Document No.");
                if PostedGenJournalLine.FindSet() then begin
                    DocumentAttachment.Reset();
                    DocumentAttachment.SetRange("Table ID", Database::"Posted Gen. Journal Line");
                    DocumentAttachment.SetRange("Source RecordID", PostedGenJournalLine.RecordId);
                    DocumentAttachment.SetRange("No.", Format(PostedGenJournalLine."Line No."));
                    if DocumentAttachment.FindFirst() then begin
                        GlEntryGrec."Attachment Included" := true;
                    end else begin
                        GlEntryGrec."Attachment Included" := false;
                    end;
                end;
            until GlEntryGrec.Next() = 0;
    end;

}
