    procedure MonthToDate(Var StartDate_Loc: Date; Var EndDate_Loc: Date)
    begin
        StartDate_Loc := CalcDate('<-CM>', StartDate);
        EndDate_Loc := CalcDate('<+CM>', StartDate);
    end;

    procedure MovingAnnualTotal(Var StartDate_Loc: Date; Var EndDate_Loc: Date)
    begin
        EndDate_Loc := EndDate;
        StartDate_Loc := CalcDate('<-12M>', EndDate);
    end;

    procedure CalculateSalesQty(PeriodType: Text; DocumentType: Enum "Item Ledger Document Type"): Decimal
    var
        SalesQty: Decimal;
        StartDate_Loc, EndDate_Loc : Date;
    begin
        if PeriodType = 'MTD' then
            MonthToDate(StartDate_Loc, EndDate_Loc)
        else if PeriodType = 'MAT' then
            MovingAnnualTotal(StartDate_Loc, EndDate_Loc)
        else
            if PeriodType = 'LTD' then begin
                StartDate_Loc := 0D;
                EndDate_Loc := Today;
            end;

        SalesQty := 0;
        ILE.Reset();
        ILE.SetRange("Posting Date", StartDate_Loc, EndDate_Loc);
        ILE.SetRange("Entry Type", ILE."Entry Type"::Sale);
        ILE.SetRange("Document Type", DocumentType);
        ILE.SetRange("Item No.", Item."No.");
        ILE.CalcSums(Quantity);
        SalesQty := ILE.Quantity;

        exit(SalesQty);
    end;

    procedure CalculateNetSalesQty(PeriodType: Text): Decimal
    var
        GrossQty, ReturnQty : Decimal;
    begin
        GrossQty := CalculateSalesQty(PeriodType, DocumentType::"Sales Invoice");
        ReturnQty := CalculateSalesQty(PeriodType, DocumentType::"Sales Return Receipt");

        exit(GrossQty - ReturnQty);
    end;

    local procedure CalculateSalesQtyByDimension(PeriodType: Text;  DocumentType: Enum "Item Ledger Document Type"; DimensionCode: Code[20]): Decimal
    var
        QtyByDimension: Decimal;
        DimSetID: Integer;
        StartDate_Loc, EndDate_Loc : Date;
    begin
        if PeriodType = 'MTD' then
            MonthToDate(StartDate_Loc, EndDate_Loc)
        else if PeriodType = 'MAT' then
            MovingAnnualTotal(StartDate_Loc, EndDate_Loc)
        else
            if PeriodType = 'LTD' then begin
                StartDate_Loc := 0D;
                EndDate_Loc := Today;
            end;

        GeneralLedgerSetup.Get();

        QtyByDimension := 0;

        DimensionSetEntry.Reset();
        DimensionSetEntry.SetRange("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 4 Code");
        DimensionSetEntry.SetRange("Dimension Value Code", DimensionCode);
        if DimensionSetEntry.FindSet() then
            DimSetID := DimensionSetEntry."Dimension Set ID";

        ILE.Reset();
        ILE.SetRange("Posting Date", StartDate_Loc, EndDate_Loc);
        ILE.SetRange("Entry Type", ILE."Entry Type"::Sale);
        ILE.SetRange("Document Type", DocumentType);
        ILE.SetRange("Item No.", Item."No.");
        ILE.SetRange("Dimension Set ID", DimSetID);
        ILE.CalcSums(Quantity);
        QtyByDimension := ILE.Quantity;
    end;

    local procedure CalculateNetSalesQtyByDimension(PeriodType: Text; DimensionCode: Code[20]): Decimal
    var
        GrossQtyByDimension, ReturnQtyByDimension : Decimal;
    begin
        GrossQtyByDimension := 0;
        ReturnQtyByDimension := 0;


        GrossQtyByDimension := CalculateSalesQtyByDimension(PeriodType, DocumentType::"Sales Invoice", DimensionCode);
        ReturnQtyByDimension := CalculateSalesQtyByDimension(PeriodType, DocumentType::"Sales Return Receipt", DimensionCode);

        exit(GrossQtyByDimension - ReturnQtyByDimension);
    end;

    procedure CalculateSalesAmount(PeriodType: Text; DocumentType: Enum "Item Ledger Document Type"): Decimal
    var
        SalesAmount: Decimal;
        StartDate_Loc, EndDate_Loc : Date;
    begin
        if PeriodType = 'MTD' then
            MonthToDate(StartDate_Loc, EndDate_Loc)
        else if PeriodType = 'MAT' then
            MovingAnnualTotal(StartDate_Loc, EndDate_Loc)
        else
            if PeriodType = 'LTD' then begin
                StartDate_Loc := 0D;
                EndDate_Loc := Today;
            end;

        SalesAmount := 0;
        ILE.Reset();
        ILE.SetRange("Posting Date", StartDate_Loc, EndDate_Loc);
        ILE.SetRange("Entry Type", ILE."Entry Type"::Sale);
        ILE.SetRange("Document Type", DocumentType);
        ILE.SetRange("Item No.", Item."No.");
        if ILE.FindSet() then
            repeat
                ILE.CalcFields("Sales Amount (Actual)");
                SalesAmount += ILE."Sales Amount (Actual)";
            until ILE.Next() = 0;
        exit(SalesAmount);
    end;

    procedure CalculateNetSalesAmount(PeriodType: Text): Decimal
    var
        GrossAmount, ReturnAmount : Decimal;
    begin
        GrossAmount := CalculateSalesAmount(PeriodType, DocumentType::"Sales Invoice");
        ReturnAmount := CalculateSalesAmount(PeriodType, DocumentType::"Sales Return Receipt");

        exit(GrossAmount - ReturnAmount);
    end;

    local procedure CalculateSalesAmountByDimension(PeriodType: Text;
  DocumentType: Enum "Item Ledger Document Type"; DimensionCode: Code[20]): Decimal
    var
        AmountByDimension: Decimal;
        StartDate_Loc, EndDate_Loc : Date;
        DimSetID: Integer;
    begin
        if PeriodType = 'MTD' then
            MonthToDate(StartDate_Loc, EndDate_Loc)
        else if PeriodType = 'MAT' then
            MovingAnnualTotal(StartDate_Loc, EndDate_Loc)
        else
            if PeriodType = 'LTD' then begin
                StartDate_Loc := 0D;
                EndDate_Loc := Today;
            end;

        GeneralLedgerSetup.Get();

        AmountByDimension := 0;

        DimensionSetEntry.Reset();
        DimensionSetEntry.SetRange("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 4 Code");
        DimensionSetEntry.SetRange("Dimension Value Code", DimensionCode);
        if DimensionSetEntry.FindSet() then
            DimSetID := DimensionSetEntry."Dimension Set ID";

        ILE.Reset();
        ILE.SetRange("Posting Date", StartDate_Loc, EndDate_Loc);
        ILE.SetRange("Entry Type", ILE."Entry Type"::Sale);
        ILE.SetRange("Document Type", DocumentType);
        ILE.SetRange("Item No.", Item."No.");
        ILE.SetRange("Dimension Set ID", DimSetID);
        if ILE.FindSet() then
            repeat
                ILE.CalcFields("Sales Amount (Actual)");
                AmountByDimension += ILE."Sales Amount (Actual)";
            until ILE.Next() = 0;
        exit(AmountByDimension);
    end;

    local procedure CalculateNetSalesAmountByDimension(PeriodType: Text; DimensionCode: Code[20]): Decimal
    var
        GrossAmountByDimension, ReturnAmountByDimension : Decimal;
    begin
        GrossAmountByDimension := 0;
        ReturnAmountByDimension := 0;


        GrossAmountByDimension := CalculateSalesAmountByDimension(PeriodType, DocumentType::"Sales Invoice", DimensionCode);
        ReturnAmountByDimension := CalculateSalesAmountByDimension(PeriodType, DocumentType::"Sales Return Receipt", DimensionCode);

        exit(GrossAmountByDimension - ReturnAmountByDimension);
    end;

    procedure GetLTDPurchaseReceipts(): Decimal
    var
        TotalQuantity: Decimal;
    begin
        TotalQuantity := 0;

        ILE.Reset();
        ILE.SetRange("Item No.", Item."No.");
        ILE.SetRange("Entry Type", ILE."Entry Type"::Purchase);
        ILE.SetRange("Document Type", ILE."Document Type"::"Purchase Receipt");
        if ILE.FindSet() then
            repeat
                TotalQuantity += ILE.Quantity;
            until ILE.Next() = 0;

        exit(TotalQuantity);
    end;

}

