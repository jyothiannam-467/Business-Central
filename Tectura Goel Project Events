    PROCEDURE CheckDivisionBalance(GenJnlLine: Record 81)
    VAR
        GenJnlLineCheck: Record 81;
        DebitAmt: Decimal;
        CreditAmt: Decimal;
        Err001: Label 'Debit & Credit not in balance for Division %1 in Document No. %2.';
        Err002: Label 'Debit & Credit is Zero for Division %1 in Document No. %2.';
        AmtP: Decimal;
        AmtN: Decimal;
    BEGIN
        GenJnlLineCheck.SETRANGE("Journal Template Name");
        GenJnlLineCheck.SETRANGE("Journal Batch Name");
        GenJnlLineCheck.SETRANGE("Document No.");
        GenJnlLineCheck.SETRANGE("Shortcut Dimension 1 Code");
        GenJnlLineCheck.SETRANGE(Amount);

        DebitAmt := 0;
        CreditAmt := 0;

        GenJnlLineCheck.SETRANGE("Journal Template Name", GenJnlLine."Journal Template Name");
        GenJnlLineCheck.SETRANGE("Journal Batch Name", GenJnlLine."Journal Batch Name");
        GenJnlLineCheck.SETRANGE("Document No.", GenJnlLine."Document No.");
        IF GenJnlLineCheck.FINDSET THEN
            REPEAT
                IF GenJnlLine."Shortcut Dimension 1 Code" = GenJnlLineCheck."Shortcut Dimension 1 Code" THEN BEGIN
                    IF GenJnlLine."Bal. Account No." = '' THEN BEGIN
                        // {
                        // DebitAmt += GenJnlLineCheck."Debit Amount";
                        // CreditAmt += GenJnlLineCheck."Credit Amount";
                        // }
                        DebitAmt += ABS(GenJnlLineCheck."Amount (LCY)");
                        CreditAmt += ABS(GenJnlLineCheck."Amount (LCY)");
                    END ELSE BEGIN
                        // {
                        // DebitAmt += GenJnlLineCheck.Amount;
                        // CreditAmt += GenJnlLineCheck.Amount;
                        // }
                        DebitAmt += GenJnlLineCheck."Amount (LCY)";
                        CreditAmt += GenJnlLineCheck."Amount (LCY)";
                    END;
                END;
            UNTIL GenJnlLineCheck.NEXT = 0;
        //williams
        IF DebitAmt <> CreditAmt THEN
            ERROR(Err001, GenJnlLine."Shortcut Dimension 1 Code", GenJnlLine."Document No.");

        IF ((DebitAmt = 0) AND (CreditAmt = 0)) THEN BEGIN
            AmtP := 0;
            AmtN := 0;
            GenJnlLineCheck.SETRANGE("Journal Template Name");
            GenJnlLineCheck.SETRANGE("Journal Batch Name");
            GenJnlLineCheck.SETRANGE("Document No.");
            GenJnlLineCheck.SETRANGE("Shortcut Dimension 1 Code");
            GenJnlLineCheck.SETRANGE(Amount);

            GenJnlLineCheck.SETRANGE("Journal Template Name", GenJnlLine."Journal Template Name");
            GenJnlLineCheck.SETRANGE("Journal Batch Name", GenJnlLine."Journal Batch Name");
            GenJnlLineCheck.SETRANGE("Document No.", GenJnlLine."Document No.");
            GenJnlLineCheck.SETRANGE("Shortcut Dimension 1 Code", GenJnlLine."Shortcut Dimension 1 Code");

            GenJnlLineCheck.SETRANGE(Amount);
            GenJnlLineCheck.SETFILTER(Amount, '>%1', 0);
            IF GenJnlLineCheck.FINDSET THEN
                REPEAT
                    AmtP += GenJnlLineCheck.Amount;
                UNTIL GenJnlLineCheck.NEXT = 0;

            GenJnlLineCheck.SETRANGE(Amount);
            GenJnlLineCheck.SETFILTER(Amount, '<%1', 0);
            IF GenJnlLineCheck.FINDSET THEN
                REPEAT
                    AmtN += GenJnlLineCheck.Amount;
                UNTIL GenJnlLineCheck.NEXT = 0;
            //williams
            //    { IF ABS(AmtP) <> ABS(AmtN) THEN
            //       ERROR(Err001,GenJnlLine."Shortcut Dimension 1 Code",GenJnlLine."Document No.");}
        END;
    END;


