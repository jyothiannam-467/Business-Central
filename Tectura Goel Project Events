    [EventSubscriber(ObjectType::Table, Database::"Sales Shipment Line", OnAfterInitFromSalesLine, '', false, false)]
    local procedure OnAfterInitFromSalesLine(SalesShptHeader: Record "Sales Shipment Header"; SalesLine: Record "Sales Line"; var SalesShptLine: Record "Sales Shipment Line");
    var
        InvtSetup: Record "Inventory Setup";
    begin
        //CR-045  -Start
        SalesShptLine."Originally Ordered No." := SalesLine."Originally Ordered No.";
        //CR-045  -End
        //# GSC-017 >>
        //SalesShptLine."No. of Pieces" := TempSalesLine."No. of Pieces to Ship";
        IF (SalesLine.Quantity = 0) OR (SalesLine."Qty. to Ship" = 0) THEN
            SalesShptLine."No. of Pieces" := 0
        ELSE BEGIN
            InvtSetup.GET;
            SalesShptLine."No. of Pieces" := ROUND((SalesLine."Qty. to Ship" / SalesLine.Quantity * SalesLine."No. of Pieces"),
                                                      InvtSetup."Quantity Decimal Precision");
        END;
        //# GSC-017 <<        
    end;

