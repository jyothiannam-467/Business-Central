    [EventSubscriber(ObjectType::Table, Database::"Sales Header", OnUpdateSalesLineByChangedFieldName, '', false, false)]
    local procedure OnUpdateSalesLineByChangedFieldName(SalesHeader: Record "Sales Header"; var SalesLine: Record "Sales Line"; ChangedFieldName: Text[100]; ChangedFieldNo: Integer; xSalesHeader: Record "Sales Header");
    begin
        //T15205 - Start
        CASE ChangedFieldName OF
            SalesLine.FIELDCAPTION("Cutting Charges for Flat"):
                IF SalesLine.Type = SalesLine.Type::Item THEN
                    SalesLine."Cutting Charges for Flat" := SalesHeader."Cutting Charges for Flat"
                ELSE
                    SalesLine."Cutting Charges for Flat" := 0;
            SalesLine.FIELDCAPTION("Cutting Charges for Round"):
                IF SalesLine.Type = SalesLine.Type::Item THEN
                    SalesLine."Cutting Charges for Round" := SalesHeader."Cutting Charges for Round"
                ELSE
                    SalesLine."Cutting Charges for Round" := 0;
        //T15205 - Stop    
        end;
    end;


    [EventSubscriber(ObjectType::Table, Database::"Sales Header", OnAfterCheckSellToCust, '', false, false)]
    local procedure OnAfterCheckSellToCust(var SalesHeader: Record "Sales Header"; xSalesHeader: Record "Sales Header"; Customer: Record Customer; CurrentFieldNo: Integer);
    VAR
        Text50000: Label 'GST Customer Type should not be blank for customer %1';
        Text50001: Label 'Phone No. or Email Id is mandatory in the Customer No. %1 to create a sales transaction.';
    begin

        //T17481_10thAug2020_Start
        IF (Customer."Phone No." = '') AND (Customer."E-Mail" = '') THEN
            ERROR(Text50001, Customer."No.");
        //T17481_10thAug2020_Stop

        // TEC.SUPP #7520 JP--
        IF Customer."GST Customer Type" = Customer."GST Customer Type"::" " THEN
            ERROR(Text50000, Customer."No.");
        // TEC.SUPP #7520 JP++

    end;


