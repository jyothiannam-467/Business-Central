    PROCEDURE CheckHeatNosQuantity(PHdr: Record 38)
    VAR
        PurLine: Record 39;
        REntry: Record 337;
        PHeatNos: Record 50002;
        HQty: Decimal;
        RVend: Record 23;
        Text50001: Label 'Total Heat Nos Quantity and Lot Quanity should be same for Lot No. %1';
        Text50002: Label 'Heat No. details does not exist for Lot No. %1';
        Text50003: Label 'Test Certificate Attachment is mandatory for Document No. %1';
        Text50004: Label 'Heat No. details does not exist for GRN No. %1 Line No. %2';
    BEGIN
        WITH PHdr DO BEGIN
            RVend.GET("Buy-from Vendor No.");
            IF "Document Type" = "Document Type"::Order THEN BEGIN
                PurLine.RESET;
                PurLine.SETRANGE("Document Type", "Document Type");
                PurLine.SETRANGE("Document No.", "No.");
                PurLine.SETFILTER("Qty. to Receive", '<>%1', 0);
                IF PurLine.FINDSET THEN
                    REPEAT
                        REntry.RESET;
                        REntry.SETRANGE("Source Type", 39);
                        REntry.SETRANGE("Source ID", "No.");
                        REntry.SETRANGE("Source Ref. No.", PurLine."Line No.");
                        IF REntry.FINDSET THEN
                            REPEAT
                                CLEAR(HQty);
                                PHeatNos.RESET;
                                PHeatNos.SETRANGE("Document No.", "No.");
                                PHeatNos.SETRANGE("Document Line No.", REntry."Source Ref. No.");
                                PHeatNos.SETRANGE("Lot No.", REntry."Lot No.");
                                PHeatNos.SETRANGE(Posted, FALSE);
                                IF PHeatNos.FINDSET THEN
                                    REPEAT
                                        HQty += PHeatNos.Quantity;
                                    UNTIL PHeatNos.NEXT = 0;
                                IF (RVend."Heat No. Applicable" = RVend."Heat No. Applicable"::"Before Receipt") AND (HQty = 0) THEN
                                    ERROR(Text50002, REntry."Lot No.");
                                IF (HQty <> 0) AND (HQty <> REntry."Qty. to Handle (Base)") THEN
                                    ERROR(Text50001, REntry."Lot No.");
                            UNTIL REntry.NEXT = 0;
                    UNTIL PurLine.NEXT = 0;
            END;
            IF "Document Type" = "Document Type"::Invoice THEN BEGIN
                //IF (RVend."Test Certificate Applicable" = RVend."Test Certificate Applicable"::"With Invoice") THEN BEGIN
                PurLine.RESET;
                PurLine.SETRANGE("Document Type", "Document Type");
                PurLine.SETRANGE("Document No.", "No.");
                PurLine.SETRANGE(Type, PurLine.Type::Item);
                PurLine.SETFILTER(Quantity, '<>%1', 0);
                IF PurLine.FINDSET THEN
                    REPEAT
                        PHeatNos.RESET;
                        PHeatNos.SETRANGE("GRN No.", PurLine."Receipt No.");
                        PHeatNos.SETRANGE("GRN Line No.", PurLine."Receipt Line No.");
                        IF PHeatNos.FINDSET THEN BEGIN
                            REPEAT
                                IF (PHeatNos."Attachment No." = 0) AND (RVend."Test Certificate Applicable" = RVend."Test Certificate Applicable"::"With Invoice") THEN
                                    ERROR(Text50003, "No.");
                            UNTIL PHeatNos.NEXT = 0;
                        END ELSE BEGIN
                            IF (RVend."Test Certificate Applicable" = RVend."Test Certificate Applicable"::"With Invoice") THEN
                                ERROR(Text50003, "No.");
                            IF (RVend."Heat No. Applicable" = RVend."Heat No. Applicable"::"Before Invoice") THEN
                                ERROR(Text50004, PurLine."Receipt No.", PurLine."Receipt Line No.");
                        END;
                    UNTIL PurLine.NEXT = 0;
                //END;
            END;
        END;
    END;

