    [EventSubscriber(ObjectType::Table, Database::"Prod. Order Line", OnBeforeDeleteRelations, '', false, false)]
    local procedure OnBeforeDeleteRelations(var ProdOrderLine: Record "Prod. Order Line");
    var
        SLine: Record 37;
        TLine: Record 5741;
        ProdLine: Record 5406;
    begin
        //TDK>>>
        IF NOT ProdOrderLine."Split Line" THEN BEGIN
            ProdLine.RESET;
            ProdLine.SETRANGE("Order No.", ProdOrderLine."Order No.");
            ProdLine.SETRANGE("Order Line No.", ProdOrderLine."Order Line No.");
            ProdLine.SETRANGE("Split Line", TRUE);
            IF ProdLine.FINDSET THEN
                ProdLine.DELETEALL(TRUE);

            IF ProdOrderLine."Order Type" = ProdOrderLine."Order Type"::Sales THEN
                IF SLine.GET(SLine."Document Type"::Order, ProdOrderLine."Order No.", ProdOrderLine."Order Line No.") THEN BEGIN
                    SLine."Prod. Order No." := '';
                    SLine."Prod. Order Line No." := 0;
                    SLine.MODIFY;
                END;
            IF ProdOrderLine."Order Type" = ProdOrderLine."Order Type"::Transfer THEN
                IF TLine.GET(ProdOrderLine."Order No.", ProdOrderLine."Order Line No.") THEN BEGIN
                    TLine."Prod. Order No." := '';
                    TLine."Prod. Order Line No." := 0;
                    TLine.MODIFY;
                END;

        END;
        //TDK<<<        
    end;


