    [EventSubscriber(ObjectType::Table, Database::"Sales Line", OnAfterAssignItemValues, '', false, false)]
    local procedure OnAfterAssignItemValues(var SalesLine: Record "Sales Line"; Item: Record Item; SalesHeader: Record "Sales Header");
    var
        GLSetup: Record "General Ledger Setup";
        Customer: Record Customer;
    begin
        IF NOT SalesLine."Retain Sales Price" THEN //T18542_12thNov2020
            SalesLine."Description 2" := Item."Description 2";
        // else
        //     SalesLine."Description 2" := '';
        //T18509_4thNov2020_Start
        GLSetup.GET;
        IF (SalesHeader."Document Type" = SalesHeader."Document Type"::Order) THEN BEGIN
            IF (SalesHeader."Customer Posting Group" = 'DOMESTIC') THEN BEGIN
                SalesLine.VALIDATE("TCS Nature of Collection", GLSetup."TCS Sales Nature");
            END;
        END;
        //T18509_4thNov2020_Stop    

        //AD_GSC-003
        SalesLine."Variant Group Type" := Item."Variant Group Type";
        //AD_GSC-003

        //T26684 13032023 Begin
        Customer.RESET;
        Customer.GET(SalesLine."Sell-to Customer No.");
        IF Customer."Exemption GST %" THEN BEGIN
            IF Customer."Exemption GST Group Code" <> '' THEN
                SalesLine."GST Group Code" := Customer."Exemption GST Group Code";
        END;
        //T26684 13032023 Begin                        
    end;


    [EventSubscriber(ObjectType::Table, Database::"Sales Line", OnValidateNoOnAfterUpdateUnitPrice, '', false, false)]
    local procedure OnValidateNoOnAfterUpdateUnitPrice(var SalesLine: Record "Sales Line"; xSalesLine: Record "Sales Line"; var TempSalesLine: Record "Sales Line" temporary);
    var
        SaleHeader: Record "Sales Header";
        SalesPrice: Record "Sales Price-GSC";
    begin
        //T24242 16MAY2022 -
        IF SalesLine."Job Work" = FALSE THEN BEGIN
            IF SalesLine.Type = SalesLine.Type::"G/L Account" THEN BEGIN
                IF SaleHeader.GET(SalesLine."Document Type", SalesLine."Document No.") THEN;
                SalesPrice.RESET;
                SalesPrice.SETRANGE("Sales Type", SalesPrice."Sales Type"::Customer);
                SalesPrice.SETRANGE("Sales Code", SalesLine."Sell-to Customer No.");
                SalesPrice.SETRANGE("G/L Account No.", SalesLine."No.");
                SalesPrice.SETFILTER("Starting Date", '<=%1', SaleHeader."Posting Date");
                SalesPrice.SETFILTER("Ending Date", '>=%1', SaleHeader."Posting Date");
                IF SalesPrice.FINDSET THEN
                    SalesLine.VALIDATE("Unit Price", SalesPrice."G/L Unit Price");
            END;
        END;
        //T24242 16MAY2022 +        
    end;

